{
  "name": "refood-web",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
